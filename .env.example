APP_NAME=real-estate-marketing-agent
ENVIRONMENT=development

GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Docker Compose: postgres:5432 | Render/Aiven: URL fournie par la plateforme
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/real_estate_agent

CHECKPOINTER_PROVIDER=redis
# Docker Compose: redis://redis:6379 | Production: URL Upstash (rediss://...)
REDIS_URL=redis://redis:6379

# MCP servers
# Docker Compose: hostnames de service | Render: Internal Service URLs
MCP_CONTENT_GENERATION_SERVER_URL=http://content-generation-server:8001/sse
MCP_PUBLICATION_SERVER_URL=http://publication-server:8002/sse

# CORS — liste JSON des origines autorisées
# Dev: ["http://localhost:5173"] | Prod: ["https://ton-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173"]

# LangSmith (optionnel)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=real-estate-marketing-agent

BUFFER_API_KEY=
