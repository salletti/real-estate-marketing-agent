GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Docker Compose: postgres:5432 | Production: URL Aiven/Render
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/real_estate_agent

CHECKPOINTER_PROVIDER=redis
# Docker Compose: redis://redis:6379 | Production: URL Upstash (rediss://...)
REDIS_URL=redis://redis:6379

# MCP servers
MCP_CONTENT_GENERATION_SERVER_URL=http://content-generation-server:8001/sse
MCP_PUBLICATION_SERVER_URL=http://publication-server:8002/sse

# CORS — liste JSON des origines autorisées
CORS_ORIGINS=["http://localhost:5173"]

# LangSmith (optionnel)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=real-estate-marketing-agent
